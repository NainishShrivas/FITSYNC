# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, webhook callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SARVAM_API_KEY: Server-side Sarvam API key.
# Note: api.sarvam.ai inference endpoints accept an API subscription key ('api-subscription-key'),
# while apps.sarvam.ai Voice Agents outbound calling expects a Voice Agents Workspace API Key ('X-API-Key').
SARVAM_API_KEY="MY_SARVAM_API_KEY"

# Sarvam AI Voice Agents Outbound Calling Credentials (https://docs.sarvam.ai/)
# Retrieve these from your Sarvam Voice Agents Dashboard -> Workspace -> Deployed Agent & Telephony Connection:
SARVAM_ORG_ID=""
SARVAM_WORKSPACE_ID=""
SARVAM_AGENT_ID=""
SARVAM_AGENT_VERSION=""
SARVAM_CONNECTION_ID=""
SARVAM_AGENT_PHONE_NUMBER=""

# Optional: HMAC-SHA256 webhook verification secret configured on your Sarvam Voice Agent webhook
SARVAM_WEBHOOK_SECRET=""
